<Window x:Class="ElectronicObserver.Window.Tools.SortieRecordViewer.SortieDetail.SortieDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectronicObserver.Window.Tools.SortieRecordViewer.SortieDetail"
        xmlns:sortie="clr-namespace:ElectronicObserver.Window.Tools.SortieRecordViewer.Sortie"
        mc:Ignorable="d"
        Title="出撃戦闘詳細" Height="720" Width="980" MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12">
    <Window.Resources>
        <!-- 勝利ランクのバッジ色 -->
        <Style x:Key="RankBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ情報 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <!-- 1段目: 基本情報 & 閉じる -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="出撃 ID:" FontWeight="Bold" Foreground="#666666" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TextSortieId" Text="12345" FontWeight="Bold" Margin="0,0,16,0"/>

                        <TextBlock Text="海域:" FontWeight="Bold" Foreground="#666666" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TextMap" Text="7-1" FontWeight="Bold" Margin="0,0,16,0"/>

                        <TextBlock Text="出撃日時:" FontWeight="Bold" Foreground="#666666" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TextStartTime" Text="2026/11/05 12:00:00" Margin="0,0,16,0"/>

                        <Border x:Name="BossStatusBadge" CornerRadius="3" Background="#E8F5E9" Padding="6,2" Margin="4,0">
                            <TextBlock x:Name="TextBossStatus" Text="ボス到達" Foreground="#2E7D32" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TextFleetSummary" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="#555555" TextTrimming="CharacterEllipsis" Margin="16,0"/>

                    <Button Grid.Column="2" Content="閉じる" Width="70" Height="25" Click="CloseButton_Click" VerticalAlignment="Center"/>
                </Grid>

                <!-- 2段目: リプレイ & 外部連携ツールバー -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="リプレイ:" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="リプレイを開く" Click="ReplayOpen_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="リプレイURLをコピー" Click="ReplayCopyUrl_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="リプレイJSONをコピー" Click="ReplayCopyJson_Click"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2,8,2"/>

                    <TextBlock Text="外部連携:" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="制空シミュレータ" Click="AirControlSim_Click" ToolTip="クリックでブラウザ表示 / 右クリックでURLコピー">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="ブラウザで開く" Click="AirControlSim_Click"/>
                                <MenuItem Header="URLをコピー" Click="AirControlSimCopy_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="作戦室" Click="OperationRoom_Click" ToolTip="クリックでブラウザ表示 / 右クリックでURLコピー">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="ブラウザで開く" Click="OperationRoom_Click"/>
                                <MenuItem Header="URLをコピー" Click="OperationRoomCopy_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="出撃データJSONコピー" Click="SortieJsonCopy_Click" ToolTip="共有用出撃レコードJSONをクリップボードにコピー"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- マス進行・戦闘詳細エリア -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
            <ItemsControl x:Name="NodesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sortie:SortieNodeInfo}">
                        <Border Margin="0,0,0,12" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                            <Expander IsExpanded="True" Padding="8">
                                <Expander.Header>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- マスセル番号 -->
                                        <Border Grid.Column="0" Background="#3F51B5" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CellDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        </Border>

                                        <!-- マス種別 -->
                                        <Border Grid.Column="1" Background="#ECEFF1" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding NodeTypeDescription}" Foreground="#37474F" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- 戦闘マス: 勝利ランク -->
                                        <Border Grid.Column="2" x:Name="RankBadge" Background="#FFF9C4" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding WinRank, StringFormat='ランク: {0}'}" Foreground="#F57F17" FontWeight="Bold"/>
                                        </Border>

                                        <!-- MVP -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="🏆 MVP: " Foreground="#795548" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MvpShipName}" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- ドロップ艦 -->
                                        <Border Grid.Column="4" Background="#E1F5FE" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DropShipName, StringFormat='🎁 {0}'}" Foreground="#0277BD" FontWeight="Bold"/>
                                        </Border>

                                        <!-- 提督・艦娘Exp -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BaseExp, StringFormat='提督Exp: {0} / 基本Exp: '}" Foreground="#757575"/>
                                            <TextBlock Text="{Binding AdmiralExp}" Foreground="#757575"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <Expander.Content>
                                    <StackPanel Margin="8,8,8,4">
                                        <!-- 非戦闘マス情報 -->
                                        <Border Background="#F9FBE7" BorderBrush="#E6EE9C" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding NonBattleInfo}" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 戦闘マス情報サマリーバー -->
                                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,8">
                                            <WrapPanel>
                                                <TextBlock Text="陣形: " FontWeight="Bold" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding FriendlyFormationText}" Margin="0,0,12,0"/>

                                                <TextBlock Text="敵陣形: " FontWeight="Bold" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding EnemyFormationText}" Margin="0,0,12,0"/>

                                                <TextBlock Text="交戦形態: " FontWeight="Bold" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding EngagementFormText}" Margin="0,0,12,0"/>

                                                <TextBlock Text="制空状態: " FontWeight="Bold" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding AirControlText}" Margin="0,0,12,0"/>

                                                <TextBlock Text="煙幕: " FontWeight="Bold" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding SmokeText}" Margin="0,0,0,0"/>
                                            </WrapPanel>
                                        </Border>

                                        <!-- 戦闘フェーズ & 攻撃ログ -->
                                        <ItemsControl ItemsSource="{Binding Phases}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type sortie:BattlePhaseInfo}">
                                                    <Border Margin="0,2,0,4" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding PhaseName}" FontWeight="Bold" Foreground="#1565C0"/>
                                                                <TextBlock Text="{Binding Summary, StringFormat=' ({0})'}" Foreground="#666666" Margin="4,0,0,0"/>
                                                                <TextBlock Text="{Binding FriendlyAircraftLost, StringFormat=' [味方艦載機損失: {0}機]'}" Foreground="#D32F2F" Margin="8,0,0,0"/>
                                                            </StackPanel>

                                                            <ItemsControl ItemsSource="{Binding Attacks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type sortie:BattleAttackEntry}">
                                                                        <TextBlock Text="{Binding DisplayText}" Margin="12,1,0,1" Foreground="#333333" FontFamily="Consolas, Meiryo UI"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- HP推移グリッド -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 味方本隊 & 随伴艦隊 -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="自軍艦隊 HP推移" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <DataGrid ItemsSource="{Binding FriendlyCombinedShips}" AutoGenerateColumns="False" IsReadOnly="True"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF" CanUserSortColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="艦名" Binding="{Binding Name}" Width="150"/>
                                                        <DataGridTextColumn Header="Lv" Binding="{Binding Level}" Width="40"/>
                                                        <DataGridTextColumn Header="HP推移" Binding="{Binding HpTransitionDisplay}" Width="120"/>
                                                        <DataGridTextColumn Header="状態" Binding="{Binding DamageStateText}" Width="60"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>

                                            <!-- 敵艦隊 -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="敵軍艦隊 HP推移" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <DataGrid ItemsSource="{Binding EnemyShipsAfter}" AutoGenerateColumns="False" IsReadOnly="True"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF" CanUserSortColumns="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="艦名" Binding="{Binding Name}" Width="160"/>
                                                        <DataGridTextColumn Header="HP推移" Binding="{Binding HpTransitionDisplay}" Width="120"/>
                                                        <DataGridTextColumn Header="状態" Binding="{Binding DamageStateText}" Width="60"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- フッター -->
        <Border Grid.Row="2" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="TextStatus" Text="戦闘詳細を読み込みました。" Foreground="#555555"/>
        </Border>
    </Grid>
</Window>
