<Window x:Class="ElectronicObserver.Window.Tools.SortieRecordViewer.SortieRecordViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectronicObserver.Window.Tools.SortieRecordViewer"
        mc:Ignorable="d"
        Title="出撃記録" Height="680" Width="1050" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="CenterTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QuickCsvButton" TargetType="Button">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. メニューバー -->
        <Menu Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="クリップボードから出撃データをインポート" Click="MenuFile_ImportJson_Click"/>
                <MenuItem Header="選択した出撃をAPIリスト形式でエクスポート (LoadAPIList互換)..." Click="MenuFile_ExportApiList_Click"/>
                <Separator/>
                <MenuItem Header="閉じる(_X)" Click="MenuFile_Close_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem x:Name="MenuView_ShowQuickCsvBar" Header="クイックCSVエクスポートバーを表示(_Q)" IsCheckable="True" IsChecked="True" Click="MenuView_ShowQuickCsvBar_Click"/>
            </MenuItem>
            <MenuItem Header="ツール(_T)">
                <MenuItem Header="データベース再読み込み(_R)" Click="MenuTool_Reload_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. クイックCSVエクスポートバー -->
        <Border x:Name="QuickCsvBorder" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="クイックCSV出力:" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="砲撃戦" Tag="Shelling" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="夜戦" Tag="Night" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="雷撃戦" Tag="Torpedo" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="航空戦" Tag="AirBattle" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="基地航空戦" Tag="AirBase" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="基地防空" Tag="AirBaseDefense" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="戦闘ランク" Tag="BattleRank" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="煙幕" Tag="SmokeScreen" Click="QuickCsvButton_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="Red砲撃" Tag="RedShelling" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="Red夜戦" Tag="RedNight" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="Red雷撃" Tag="RedTorpedo" Click="QuickCsvButton_Click"/>
                <Button Style="{StaticResource QuickCsvButton}" Content="Red航空" Tag="RedAirBattle" Click="QuickCsvButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 3. 検索フィルタバー -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 期間指定 -->
                <TextBlock Text="期間:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="PickerStartDate" Width="115" Height="24" Margin="0,0,4,0"/>
                <TextBox x:Name="TextStartTime" Width="55" Height="24" Text="00:00" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="〜" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="PickerEndDate" Width="115" Height="24" Margin="0,0,4,0"/>
                <TextBox x:Name="TextEndTime" Width="55" Height="24" Text="23:59" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <!-- 海域 & マップ -->
                <TextBlock Text="海域:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ComboWorld" Width="75" Height="24" Margin="0,0,8,0" SelectionChanged="FilterControl_Changed"/>

                <TextBlock Text="マップ:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="ComboMap" Width="65" Height="24" Margin="0,0,16,0" SelectionChanged="FilterControl_Changed"/>

                <!-- ボス到達チェック -->
                <CheckBox x:Name="CheckBossOnly" Content="ボス到達のみ" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- 検索 & リセットボタン -->
                <Button Content="検索" Width="70" Height="25" Click="SearchButton_Click" Background="#2196F3" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0"/>
                <Button Content="リセット" Width="65" Height="25" Click="ResetButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 4. 出撃一覧 DataGrid -->
        <DataGrid x:Name="SortieDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" CanUserSortColumns="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="#FFFFFF" RowHeaderWidth="0"
                  BorderThickness="0" MouseDoubleClick="SortieDataGrid_MouseDoubleClick"
                  SelectionChanged="SortieDataGrid_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="戦闘詳細を表示" Click="Context_OpenDetail_Click" FontWeight="Bold"/>
                    <MenuItem Header="出撃コストを表示" Click="Context_OpenCost_Click"/>
                    <Separator/>
                    <MenuItem Header="リプレイ">
                        <MenuItem Header="リプレイURLをブラウザで開く" Click="Context_OpenReplayUrl_Click"/>
                        <MenuItem Header="リプレイURLをコピー" Click="Context_CopyReplayUrl_Click"/>
                        <MenuItem Header="リプレイJSONをコピー" Click="Context_CopyReplayJson_Click"/>
                    </MenuItem>
                    <MenuItem Header="外部連携">
                        <MenuItem Header="制空権シミュレータ (kc-web) で開く" Click="Context_OpenKcWeb_Click"/>
                        <MenuItem Header="制空権シミュレータURLをコピー" Click="Context_CopyKcWebUrl_Click"/>
                        <MenuItem Header="作戦室 (Jervis) で開く" Click="Context_OpenJervis_Click"/>
                        <MenuItem Header="作戦室URLをコピー" Click="Context_CopyJervisUrl_Click"/>
                        <MenuItem Header="デッキビルダー形式JSONをコピー" Click="Context_CopyDeckBuilder_Click"/>
                    </MenuItem>
                    <MenuItem Header="データ出力">
                        <MenuItem Header="出撃データをクリップボードへコピー (共有用JSON)" Click="Context_CopySortieJson_Click"/>
                        <MenuItem Header="選択した出撃をAPIリスト形式でエクスポート (LoadAPIList互換)..." Click="Context_ExportApiList_Click"/>
                    </MenuItem>
                    <MenuItem Header="CSVエクスポート">
                        <MenuItem Header="砲撃戦 CSV" Tag="Shelling" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="夜戦 CSV" Tag="Night" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="雷撃戦 CSV" Tag="Torpedo" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="航空戦 CSV" Tag="AirBattle" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="基地航空戦 CSV" Tag="AirBase" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="基地防空 CSV" Tag="AirBaseDefense" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="戦闘ランク CSV" Tag="BattleRank" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="煙幕 CSV" Tag="SmokeScreen" Click="QuickCsvButton_Click"/>
                        <Separator/>
                        <MenuItem Header="Logbook Red 砲撃戦 CSV" Tag="RedShelling" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="Logbook Red 夜戦 CSV" Tag="RedNight" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="Logbook Red 雷撃戦 CSV" Tag="RedTorpedo" Click="QuickCsvButton_Click"/>
                        <MenuItem Header="Logbook Red 航空戦 CSV" Tag="RedAirBattle" Click="QuickCsvButton_Click"/>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterTextBlock}"/>
                <DataGridTextColumn Header="海域" Binding="{Binding MapDisplay}" Width="55" ElementStyle="{StaticResource CenterTextBlock}"/>
                <DataGridTextColumn Header="出撃日時" Binding="{Binding SortieStartDisplay}" Width="135" ElementStyle="{StaticResource CenterTextBlock}"/>
                <DataGridTextColumn Header="艦隊種別" Binding="{Binding FleetTypeDisplay}" Width="75" ElementStyle="{StaticResource CenterTextBlock}"/>
                <DataGridTemplateColumn Header="出撃艦隊" Width="*" MinWidth="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FleetSummary}" ToolTip="{Binding FleetDetailsTooltip}"
                                       VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="支援" Binding="{Binding SupportDisplay}" Width="70" ElementStyle="{StaticResource CenterTextBlock}"/>
                <DataGridTextColumn Header="基地航空隊" Binding="{Binding AirBaseDisplay}" Width="80" ElementStyle="{StaticResource CenterTextBlock}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 5. ステータスバー -->
        <Border Grid.Row="4" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TextStatusCount" Grid.Column="0" Text="表示件数: 0 件 (選択: 0 件)" Foreground="#333333" Margin="0,0,16,0"/>
                <TextBlock x:Name="TextStatusTime" Grid.Column="1" Text="検索時間: 0 ms" Foreground="#666666" Margin="0,0,16,0"/>
                <TextBlock x:Name="TextStatusMessage" Grid.Column="2" Text="準備完了" Foreground="#555555" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
