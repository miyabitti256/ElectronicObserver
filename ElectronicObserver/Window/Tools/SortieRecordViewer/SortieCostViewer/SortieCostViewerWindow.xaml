<Window x:Class="ElectronicObserver.Window.Tools.SortieRecordViewer.SortieCostViewer.SortieCostViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="出撃コスト詳細" Height="680" Width="920" MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="1.6*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TextTargetTitle" Text="対象出撃: 1 件" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TextTargetDetails" Text="出撃ID: #1 (7-1)" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CSVコピー" Width="90" Height="26" Click="CopyCsvButton_Click" Margin="0,0,8,0"/>
                    <Button Content="閉じる" Width="70" Height="26" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 上部: 出撃一覧 DataGrid (1行 = 1出撃) -->
        <Border Grid.Row="1" Margin="16,10,16,6" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,6">
                    <TextBlock Text="出撃一覧 (行選択で下記に詳細内訳を表示)" FontWeight="Bold" Foreground="#495057"/>
                </Border>

                <DataGrid x:Name="SortieListDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF"
                          CanUserSortColumns="True" SelectionMode="Single" RowHeaderWidth="0"
                          SelectionChanged="SortieListDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                        <DataGridTextColumn Header="海域" Binding="{Binding Area}" Width="60" ElementStyle="{StaticResource CenterText}"/>
                        <DataGridTextColumn Header="出撃日時" Binding="{Binding SortieStartDisplay}" Width="135" ElementStyle="{StaticResource CenterText}"/>
                        <DataGridTextColumn Header="燃料" Binding="{Binding FuelDisplay}" Width="75" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="弾薬" Binding="{Binding AmmoDisplay}" Width="75" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="鋼材" Binding="{Binding SteelDisplay}" Width="75" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="ボーキ" Binding="{Binding BauxiteDisplay}" Width="75" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="バケツ" Binding="{Binding BucketDisplay}" Width="65" ElementStyle="{StaticResource CenterText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 下部: 選択出撃の内訳 (左) と 全体合計サマリー (右) -->
        <Grid Grid.Row="2" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 選択出撃の内訳テーブル -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F8E9" BorderBrush="#DCEDC8" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock x:Name="TextSelectedSortieTitle" Text="選択された出撃の内訳" FontWeight="Bold" Foreground="#33691E"/>
                    </Border>

                    <DataGrid x:Name="SelectedDetailDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF"
                              CanUserSortColumns="False" SelectionMode="Single" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="消費項目" Binding="{Binding Title}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="燃料" Binding="{Binding FuelDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="弾薬" Binding="{Binding AmmoDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="鋼材" Binding="{Binding SteelDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="ボーキ" Binding="{Binding BauxiteDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="8,5">
                        <StackPanel>
                            <TextBlock x:Name="TextSelectedBuckets" Text="バケツ: 0 個" Foreground="#555555" FontSize="11"/>
                            <TextBlock x:Name="TextSelectedDamage" Text="損害: 無傷 0, 小破 0, 中破 0, 大破 0, 撃沈 0" Foreground="#777777" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右: 全体合計サマリーテーブル -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock x:Name="TextTotalSummaryTitle" Text="全選択出撃の合計内訳" FontWeight="Bold" Foreground="#0D47A1"/>
                    </Border>

                    <DataGrid x:Name="TotalDetailDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF"
                              CanUserSortColumns="False" SelectionMode="Single" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="消費項目" Binding="{Binding Title}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="燃料" Binding="{Binding FuelDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="弾薬" Binding="{Binding AmmoDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="鋼材" Binding="{Binding SteelDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                            <DataGridTextColumn Header="ボーキ" Binding="{Binding BauxiteDisplay}" Width="60" ElementStyle="{StaticResource RightText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="8,5">
                        <StackPanel>
                            <TextBlock x:Name="TextTotalBuckets" Text="総バケツ: 0 個" Foreground="#555555" FontSize="11"/>
                            <TextBlock x:Name="TextTotalDamage" Text="総損害: 無傷 0, 小破 0, 中破 0, 大破 0, 撃沈 0" Foreground="#777777" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- フッター/ステータス -->
        <Border Grid.Row="3" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="TextStatus" Text="コスト計算が完了しました。" Foreground="#555555"/>
        </Border>
    </Grid>
</Window>
